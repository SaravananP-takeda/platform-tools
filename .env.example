# ── Provider ──────────────────────────────────────────────────────────────────
# "mock" runs without any API key (default). Set to "openai" for real calls.
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # or Azure OpenAI endpoint

# ── Model names (used when LLM_PROVIDER=openai) ───────────────────────────────
SMALL_MODEL=gpt-3.5-turbo
MEDIUM_MODEL=gpt-4o-mini
LARGE_MODEL=gpt-4o

# ── Model pricing (USD per 1k tokens) ────────────────────────────────────────
SMALL_COST_INPUT=0.0005
SMALL_COST_OUTPUT=0.0015
MEDIUM_COST_INPUT=0.00015
MEDIUM_COST_OUTPUT=0.0006
LARGE_COST_INPUT=0.005
LARGE_COST_OUTPUT=0.015

# ── Cache ─────────────────────────────────────────────────────────────────────
EXACT_CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_SIMILARITY_THRESHOLD=0.90
CACHE_MAX_SIZE=500

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
RETRIEVAL_RERANK_TOP_K=3
KNOWLEDGE_BASE_PATH=data/knowledge_base.md

# ── Context ───────────────────────────────────────────────────────────────────
MAX_CONTEXT_TOKENS=3000
MAX_HISTORY_TURNS=6

# ── Routing thresholds ────────────────────────────────────────────────────────
# Complexity score below LOW → small model; above HIGH → large model
COMPLEXITY_LOW_THRESHOLD=0.35
COMPLEXITY_HIGH_THRESHOLD=0.65
# Escalate to next tier when model confidence falls below this
CONFIDENCE_ESCALATION_THRESHOLD=0.45
